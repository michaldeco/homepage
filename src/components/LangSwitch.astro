---
// Language switch: both codes in a fixed order (EN · SK), the current one highlighted,
// the other one a link to the same page in that language (by default its home page).
import { homePath, languages, pathsFor, t, type Lang, type PagePaths } from '../i18n/ui';

interface Props {
  lang: Lang;
  paths?: PagePaths;
}

const { lang, paths = pathsFor(homePath) } = Astro.props;
---

<span class="lang-switch">
  {
    languages.map((code, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        {code === lang ? (
          <span class="current" lang={code} aria-current="true">{code.toUpperCase()}</span>
        ) : (
          <a href={paths[code]} hreflang={code} lang={code} title={t(code)['switch.title']}>{code.toUpperCase()}</a>
        )}
      </>
    ))
  }
</span>
